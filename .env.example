# Bootstrap administrator. The password is used only until the first administrator is created.
IW_ADMIN_USERNAME=owner
IW_ADMIN_PASSWORD=

# Set true only when a trusted HTTPS reverse proxy is the browser-facing entry point.
IW_SESSION_COOKIE_SECURE=false
IW_FORWARDED_ALLOW_IPS=127.0.0.1

# Host listener and persistent shared storage for both the web and worker services.
IW_HTTP_BIND=0.0.0.0
IW_HTTP_PORT=8080
IW_DATA_ROOT_HOST=./data
